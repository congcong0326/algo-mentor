# 个人自部署配置样例。`make selfhost-env` 会复制为 .env 并自动填充随机密码/密钥。
# AI 提供商、API Key 与模型不在这里配置：启动后用管理员账号登录，在管理后台的 AI 设置中填写。

# ---- 访问 ----
# 对外端口；仅本机访问可把 APP_BIND 改为 127.0.0.1，公网访问建议前置 HTTPS 反向代理。
APP_PORT=8080
APP_BIND=0.0.0.0
TZ=Asia/Shanghai

# ---- 账号 ----
# 管理员邮箱（逗号分隔）。用该邮箱注册/登录的账号拥有管理后台权限。
AUTH_ADMIN_EMAILS=admin@example.com
# 以下两个登录开关只在数据库首次初始化登录设置时生效；之后请在管理后台「登录设置」中修改
# （例如自己注册完成后关闭注册）。
AUTH_PASSWORD_LOGIN_ENABLED=true
AUTH_PASSWORD_REGISTRATION_ENABLED=true
# 通过 HTTPS 访问时改为 true。
AUTH_COOKIE_SECURE=false

# ---- 密钥（必填，make selfhost-env 自动生成）----
POSTGRES_PASSWORD=change-me
LEARNER_PROFILE_DOCUMENT_STATEMENT_REF_HMAC_SECRET=change-me

# ---- 资源（可选）----
JAVA_OPTS=-Xms128m -Xmx512m -XX:+ExitOnOutOfMemoryError
REDIS_MAXMEMORY=64mb
