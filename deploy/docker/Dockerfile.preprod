# 预发布镜像的构建上下文只包含已验证的 mentor-api.jar 制品。
FROM eclipse-temurin:17-jre

WORKDIR /app

ARG APP_UID=10001
ARG APP_GID=10001

RUN groupadd --system --gid "${APP_GID}" algo-mentor \
    && useradd --system --uid "${APP_UID}" --gid "${APP_GID}" --home-dir /app --no-create-home algo-mentor

COPY --chown=algo-mentor:algo-mentor mentor-api.jar /app/app.jar

USER algo-mentor

ENV LOG_PATH=/var/log/algo-mentor \
    JAVA_TOOL_OPTIONS="-Xms256m -Xmx3g -XX:+ExitOnOutOfMemoryError"

EXPOSE 18080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
