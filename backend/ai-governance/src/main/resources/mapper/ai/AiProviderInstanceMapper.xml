<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.congcong.algomentor.ai.governance.provider.repository.mybatis.AiProviderInstanceMapper">

  <resultMap id="AiProviderInstanceRowMap"
      type="org.congcong.algomentor.ai.governance.provider.repository.mybatis.model.AiProviderInstanceRow">
    <constructor>
      <idArg column="id" javaType="java.lang.Long"/>
      <arg column="name" javaType="java.lang.String"/>
      <arg column="provider_type" javaType="java.lang.String"/>
      <arg column="enabled" javaType="_boolean"/>
      <arg column="config" javaType="com.fasterxml.jackson.databind.JsonNode"
           typeHandler="org.congcong.algomentor.ai.governance.provider.repository.mybatis.JsonNodeJsonbTypeHandler"/>
      <arg column="created_at" javaType="java.time.Instant"/>
      <arg column="updated_at" javaType="java.time.Instant"/>
    </constructor>
  </resultMap>

  <sql id="ProviderInstanceColumns">
    id, name, provider_type, enabled, config, created_at, updated_at
  </sql>

  <select id="findAll" resultMap="AiProviderInstanceRowMap">
    SELECT <include refid="ProviderInstanceColumns" />
    FROM ai_provider_instance
    ORDER BY name, id
  </select>

  <select id="findById" resultMap="AiProviderInstanceRowMap">
    SELECT <include refid="ProviderInstanceColumns" />
    FROM ai_provider_instance
    WHERE id = #{id}
  </select>

  <select id="findByName" resultMap="AiProviderInstanceRowMap">
    SELECT <include refid="ProviderInstanceColumns" />
    FROM ai_provider_instance
    WHERE name = #{name}
  </select>

  <select id="insert"
      parameterType="org.congcong.algomentor.ai.governance.provider.repository.mybatis.model.AiProviderInstanceRow"
      resultType="long"
      affectData="true">
    INSERT INTO ai_provider_instance (
      name, provider_type, enabled, config, created_at, updated_at
    )
    VALUES (
      #{name}, #{providerType}, #{enabled},
      #{config,typeHandler=org.congcong.algomentor.ai.governance.provider.repository.mybatis.JsonNodeJsonbTypeHandler},
      #{createdAt}, #{updatedAt}
    )
    RETURNING id
  </select>

  <update id="update"
      parameterType="org.congcong.algomentor.ai.governance.provider.repository.mybatis.model.AiProviderInstanceRow">
    UPDATE ai_provider_instance
    SET name = #{name},
        enabled = #{enabled},
        config = #{config,typeHandler=org.congcong.algomentor.ai.governance.provider.repository.mybatis.JsonNodeJsonbTypeHandler},
        updated_at = #{updatedAt}
    WHERE id = #{id}
  </update>
</mapper>
