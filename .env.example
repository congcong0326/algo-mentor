# 公共入口端口，由本地反向代理监听。
PROXY_PORT=8080
# Java Spring Boot 实际监听端口。SERVER_PORT 保留给旧脚本兼容，优先使用 API_PORT。
API_PORT=18080
SERVER_PORT=18080
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090

POSTGRES_DB=algo_mentor
POSTGRES_USER=algo_mentor
POSTGRES_PASSWORD=algo_mentor_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_LOGIN_SUCCESS_URL=/
AUTH_LOGOUT_SUCCESS_URL=/
AUTH_SESSION_TIMEOUT=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

AI_GATEWAY_DEFAULT_PROVIDER=openai
AI_GATEWAY_DEFAULT_MODEL=gpt-5.2
LEARNING_PLAN_DRAFT_SSE_TIMEOUT=6m
AGENT_CONVERSATION_SSE_TIMEOUT=6m

OPENAI_ENABLED=false
# 测试 key 占位说明：只有已吊销、无计费权限或无外部访问权限的测试 key，泄露后才不会产生实际影响。
# 真实 OpenAI key 不要提交到仓库，请在本机环境变量或未跟踪的本地配置中设置。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2
OPENAI_TIMEOUT=30s
OPENAI_STREAM_TIMEOUT=5m
OPENAI_MAX_RETRIES=2

AGENT_CALCULATOR_TOOL_ENABLED=true
AGENT_TOOL_CHOICE=auto
AGENT_SPECIFIC_TOOL_NAME=

# Code Review 默认开启；持久化、队列、AI 与 Agent Tool 未完整装配时应用拒绝启动。
PRACTICE_CODE_REVIEW_ENABLED=true

# 持久化队列消费者仅能在经部署门禁确认的唯一节点上开启。
QUEUE_MESSAGE_MAX_VALUE_BYTES=65536
QUEUE_CONSUMER_ENABLED=false
QUEUE_CONSUMER_POLL_INTERVAL=10s
QUEUE_CONSUMER_SHUTDOWN_TIMEOUT=30s
QUEUE_CLEANUP_SUCCEEDED_RETENTION=7d
QUEUE_CLEANUP_FIXED_DELAY=1h
QUEUE_CLEANUP_BATCH_SIZE=1000

# 学习者画像全部默认关闭；只能按 rollout runbook 在唯一消费节点灰度开启。
LEARNER_PROFILE_CONTENT_MAX_CHARS=4000
LEARNER_PROFILE_REVIEW_CONSUMER_ENABLED=false
LEARNER_PROFILE_CODE_REVIEW_CONSUMER_MAX_STALE_RETRIES=1
LEARNER_PROFILE_DECLARED_UPDATE_ENABLED=false
LEARNER_PROFILE_DECLARED_UPDATE_MAX_STALE_RETRIES=1
LEARNER_PROFILE_DECLARED_UPDATE_RESULT_SUMMARY_MAX_CHARS=300
LEARNER_PROFILE_PRACTICE_RECALL_ENABLED=false
LEARNER_PROFILE_PROMPT_TOKEN_BUDGET=800
PRACTICE_CHAT_PROMPT_TOKEN_BUDGET=8000
