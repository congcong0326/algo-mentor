# 公共入口端口，由本地反向代理监听。
PROXY_PORT=8080
# Java Spring Boot 实际监听端口。SERVER_PORT 保留给旧脚本兼容，优先使用 API_PORT。
API_PORT=18080
SERVER_PORT=18080
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090

POSTGRES_DB=algo_mentor
POSTGRES_USER=algo_mentor
POSTGRES_PASSWORD=algo_mentor_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_LOGIN_SUCCESS_URL=/
AUTH_LOGOUT_SUCCESS_URL=/
AUTH_SESSION_TIMEOUT=7d
AUTH_SESSION_MONITORING_ACTIVE_WINDOW=5m
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
# 内测切换到第三方 OAuth 后，可分别关闭密码登录和自助注册。
AUTH_PASSWORD_LOGIN_ENABLED=false
AUTH_PASSWORD_REGISTRATION_ENABLED=false

LEARNING_PLAN_DRAFT_SSE_TIMEOUT=6m
LEARNING_PLAN_QUOTA_ZONE=UTC
LEARNING_PLAN_DRAFT_CLEANUP_ENABLED=true
LEARNING_PLAN_DRAFT_CLEANUP_FIXED_DELAY=1h
LEARNING_PLAN_DRAFT_CLEANUP_BATCH_SIZE=1000
LEARNING_PLAN_DRAFT_USAGE_RETENTION_DAYS=30
LEARNING_PLAN_GENERATION_RECOVERY_ENABLED=true
LEARNING_PLAN_GENERATION_RECOVERY_MINIMUM_AGE=1m
LEARNING_PLAN_REALTIME_STREAM_ENABLED=true
LEARNING_PLAN_REALTIME_STREAM_HOST=localhost
LEARNING_PLAN_REALTIME_STREAM_PORT=6380
LEARNING_PLAN_REALTIME_STREAM_DATABASE=0
LEARNING_PLAN_REALTIME_STREAM_USERNAME=
LEARNING_PLAN_REALTIME_STREAM_PASSWORD=
LEARNING_PLAN_REALTIME_STREAM_SSL_ENABLED=false
LEARNING_PLAN_REALTIME_STREAM_COMMAND_TIMEOUT=3s
LEARNING_PLAN_REALTIME_STREAM_CONNECT_TIMEOUT=2s
LEARNING_PLAN_REALTIME_STREAM_SHUTDOWN_TIMEOUT=2s
LEARNING_PLAN_REALTIME_STREAM_READ_BLOCK=2s
LEARNING_PLAN_REALTIME_STREAM_MAX_READ_CONNECTIONS=32
LEARNING_PLAN_REALTIME_STREAM_ACTIVE_RETENTION=2h
LEARNING_PLAN_REALTIME_STREAM_COMPLETED_RETENTION=24h
AGENT_CONVERSATION_SSE_TIMEOUT=6m

AGENT_CALCULATOR_TOOL_ENABLED=true
AGENT_TOOL_CHOICE=auto
AGENT_SPECIFIC_TOOL_NAME=
AGENT_EXECUTOR_GROUP_PRACTICE=27
AGENT_EXECUTOR_GROUP_LEARNING_PLAN=2
AGENT_EXECUTOR_GROUP_LEARNER_PROFILE_BACKGROUND=1
AGENT_EXECUTOR_KEEP_ALIVE=60s
AGENT_EXECUTOR_SHUTDOWN_TIMEOUT=30s
AGENT_EXECUTOR_THREAD_NAME_PREFIX=agent-loop-

# Learner Profile evidence refs 使用独立 HMAC；每个环境生成并保管唯一的长随机值。
LEARNER_PROFILE_DOCUMENT_STATEMENT_REF_HMAC_SECRET=

# Code Review 默认开启；持久化、队列、AI 与 Agent Tool 未完整装配时应用拒绝启动。
PRACTICE_CODE_REVIEW_ENABLED=true

# 持久化队列消费者仅能在经部署门禁确认的唯一节点上开启。
QUEUE_MESSAGE_MAX_VALUE_BYTES=65536
QUEUE_CONSUMER_ENABLED=false
QUEUE_CONSUMER_POLL_INTERVAL=10s
QUEUE_CONSUMER_SHUTDOWN_TIMEOUT=30s
QUEUE_CLEANUP_SUCCEEDED_RETENTION=7d
QUEUE_CLEANUP_FIXED_DELAY=1h
QUEUE_CLEANUP_BATCH_SIZE=1000

# 学习者画像全部默认关闭；只能按 rollout runbook 在唯一消费节点灰度开启。
LEARNER_PROFILE_CONTENT_MAX_CHARS=4000
LEARNER_PROFILE_REVIEW_CONSUMER_ENABLED=false
LEARNER_PROFILE_CODE_REVIEW_CONSUMER_MAX_STALE_RETRIES=1
LEARNER_PROFILE_DECLARED_UPDATE_ENABLED=false
LEARNER_PROFILE_DECLARED_UPDATE_MAX_STALE_RETRIES=1
LEARNER_PROFILE_DECLARED_UPDATE_RESULT_SUMMARY_MAX_CHARS=300
LEARNER_PROFILE_PRACTICE_RECALL_ENABLED=false
LEARNER_PROFILE_PROMPT_TOKEN_BUDGET=800
PRACTICE_CHAT_LEARNING_STATE_TOOL_ENABLED=true
PRACTICE_CHAT_NOTE_APPEND_TOOL_ENABLED=true
PRACTICE_CHAT_PROMPT_TOKEN_BUDGET=8000
